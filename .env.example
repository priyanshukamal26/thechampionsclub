# Supabase connection (optional — the demo runs local-first without it)
# 1. Create a free project at https://supabase.com
# 2. Project Settings -> API -> copy the Project URL and the anon public key
# 3. Copy this file to .env.local and fill in the values
# 4. Push supabase/migrations/20261121000001_core_schema.sql with the Supabase CLI
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
